# Data da venda do sistema.
VITE_LICENSE_PURCHASE=2026-09-08

# Primeiro vencimento. Bloqueia NESTE dia.
VITE_LICENSE_FIRST_DUE=2026-10-08

# Dia do vencimento nos meses seguintes (09/11, 09/12, 09/01...).
VITE_LICENSE_DUE_DAY=9

# Dias de tolerancia depois do vencimento. 0 = bloqueia no proprio dia.
VITE_LICENSE_GRACE_DAYS=0

# Quantos dias antes o cliente comeca a ver o aviso de vencimento.
VITE_LICENSE_WARN_DAYS=7

# ATENCAO: deixe VAZIO no dia a dia.
# O desbloqueio normal e feito pelo Firebase (settings/licenca), que e
# instantaneo. Esta variavel e so um plano B para se o Firestore cair:
# preencher aqui exige um novo deploy para valer.
VITE_LICENSE_PAID_UNTIL=
